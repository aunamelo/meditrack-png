APP_NAME="MediTrack PNG"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://meditrackpng.duckdns.org

# Used by Caddy for Let's Encrypt (must match your DuckDNS / domain name)
DOMAIN=meditrackpng.duckdns.org
ACME_EMAIL=admin@meditrackpng.duckdns.org

APP_TIMEZONE=Pacific/Port_Moresby

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=meditrack_png
DB_USERNAME=meditrack
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_root_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@health.gov.pg"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Set to true on first deploy only, then set false (avoids duplicate-seed errors)
RUN_SEED=false

# Host ports (Caddy terminates TLS)
HTTP_PORT=80
HTTPS_PORT=443

# Microsoft 365 / Entra ID (optional)
# Register: https://meditrackpng.duckdns.org/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
